NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# The API never talks to RabbitMQ directly - it only writes rows into its own
# outbox_events table (see src/infrastructure/outbox). services/outbox-publisher
# is the only process that reads that table and reaches the broker, so this
# service intentionally has no RABBITMQ_URL.
#
# Controls the in-process notification subscriber (MVP fallback for when
# services/notifications-service isn't running). Set to false now that
# notifications-service's HTTP + consumer fully replace it (Phase 11 Task
# 11.3), so notifications/emails aren't created twice - see
# docs/architecture/service-ownership.md, "side-effect ownership".
IN_PROCESS_NOTIFICATIONS_ENABLED=false
