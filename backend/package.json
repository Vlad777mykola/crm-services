{
  "name": "@crm/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:generate-types": "openapi-typescript ../contracts/openapi.yaml -o src/autogenerated/openapi.ts",
    "openapi:check": "yarn openapi:generate-types && git diff --exit-code src/autogenerated",
    "migration:generate": "tsx ../node_modules/typeorm/cli.js migration:generate -d src/infrastructure/database/data-source.ts",
    "migration:run": "tsx ../node_modules/typeorm/cli.js migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "tsx ../node_modules/typeorm/cli.js migration:revert -d src/infrastructure/database/data-source.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
