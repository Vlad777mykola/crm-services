#!/usr/bin/env sh

is_branch_checkout="$3"

if [ "$is_branch_checkout" != "1" ]; then
  exit 0
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "HEAD")

if [ "$branch" = "main" ]; then
  exit 0
fi

pattern='^[0-9]+\.[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$'

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo ""
  echo "Warning: branch '$branch' doesn't match <ticket>-<description> (e.g. 1.01-fsd-import-boundaries)."
  echo "Commits here will be rejected until you rename it: git branch -m <ticket>-<description>"
  echo ""
fi

exit 0
