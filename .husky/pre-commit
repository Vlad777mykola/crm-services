#!/usr/bin/env sh

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "HEAD")

if [ "$branch" = "main" ]; then
  exit 0
fi

pattern='^[0-9]+\.[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$'

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo ""
  echo "Invalid branch name: '$branch'"
  echo "Expected: <ticket>-<description>, e.g. 1.01-fsd-import-boundaries"
  echo "  ticket = docs/tasks id (major.minor, see .cursor/skills/archive-task)"
  echo "Rename with: git branch -m <ticket>-<description>"
  echo ""
  exit 1
fi
