{
  "name": "@crm/rabbitmq-lab-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development/student-only microservice for learning RabbitMQ using the same engineering patterns as the CRM. Writes only to the student.rabbitmq-lab.* namespace and never publishes into real CRM domain exchanges. Never deployed to production. See docs/students/rabitmq/lab-service/START-HERE.md.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.6",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
