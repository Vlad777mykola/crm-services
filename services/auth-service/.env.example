NODE_ENV=development
PORT=4001
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Same physical Postgres instance as legacy-backend, own schema (auth_schema)
# - see docs/architecture/table-ownership-matrix.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm

# Needed since Phase 5 - consumes company-member.added/.removed into
# auth_membership_projection.
RABBITMQ_URL=amqp://crm:crm_local_only@localhost:5672

# Must match legacy-backend's JWT_ACCESS_SECRET exactly so tokens issued here
# are still accepted by not-yet-extracted legacy routes (Phase 2 Task 2.6).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken
