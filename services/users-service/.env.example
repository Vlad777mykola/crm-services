NODE_ENV=development
PORT=4002
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
RABBITMQ_URL=amqp://crm:crm_local_only@localhost:5672

# Must match auth-service's/legacy-backend's JWT_ACCESS_SECRET exactly - this
# service only verifies tokens (GET/PATCH /users/me), never issues them.
JWT_ACCESS_SECRET=dev-access-secret-change-me
LOG_LEVEL=info
