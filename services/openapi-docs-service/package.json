{
  "name": "@crm/openapi-docs-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev-only Swagger UI for the hand-written OpenAPI contract. Never deployed to production.",
  "scripts": {
    "dev": "node ../../scripts/contracts/bundle-openapi.mjs && tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
