{
  "name": "@crm/notifications-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Consumes domain.events + analytics.events, sends simulated emails, and creates in-app notifications; serves GET/POST /notifications/me* HTTP API. Owns notifications_schema (notifications, email_logs, processed_events). See docs/architecture/microservices-extraction-checklist.md Phase 11.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crm/messaging-kit": "0.0.0",
    "amqplib": "^0.10.9",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.6",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
