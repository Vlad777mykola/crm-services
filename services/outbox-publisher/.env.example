DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
# Schema owning outbox_events. Empty = public.outbox_events (legacy backend).
# Per-service instances set this instead of DATABASE_URL search_path hacks:
# OUTBOX_SCHEMA=auth_schema
RABBITMQ_URL=amqp://crm:crm_local_only@localhost:5672
POLL_INTERVAL_MS=1000
BATCH_SIZE=50
MAX_ATTEMPTS=5
HEALTH_PORT=4500
LOG_LEVEL=info
