{
  "name": "@crm/fill-dump-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone seed script — fills microservice Postgres schemas with realistic fake data and fixed test login credentials. Uses `pg` directly; no backend dependency.",
  "scripts": {
    "seed": "tsx src/index.ts",
    "seed:reset": "tsx src/index.ts --reset",
    "seed:companies": "tsx src/seed-companies-only.ts",
    "seed:companies:reset": "tsx src/seed-companies-only.ts --reset",
    "migrate": "tsx src/migrate-only.ts",
    "reset-only": "tsx src/reset-only.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.11.6",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  }
}
