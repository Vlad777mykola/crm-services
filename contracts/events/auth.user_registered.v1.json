{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crm-services/contracts/events/auth.user_registered.v1.json",
  "title": "auth.user_registered",
  "description": "Published when a new identity is created via POST /auth/register. Exchange: domain.events. Routing key: auth.user_registered.",
  "type": "object",
  "required": ["userId", "email", "name"],
  "additionalProperties": false,
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "format": "email" },
    "name": { "type": "string" }
  }
}
