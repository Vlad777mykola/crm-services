{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crm-services/contracts/events/appointment.cancelled.v1.json",
  "title": "appointment.cancelled",
  "description": "Published when a client cancels their own appointment request. Exchange: domain.events. Routing key: appointment.cancelled.",
  "type": "object",
  "required": ["appointmentId", "companyId", "serviceId", "serviceName", "clientName", "requestedStartAt"],
  "additionalProperties": false,
  "properties": {
    "appointmentId": { "type": "string", "format": "uuid" },
    "companyId": { "type": "string", "format": "uuid" },
    "serviceId": { "type": "string", "format": "uuid" },
    "serviceName": { "type": "string" },
    "clientName": { "type": "string" },
    "requestedStartAt": { "type": "string", "format": "date-time" }
  }
}
