{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crm-services/contracts/events/company-member.role_changed.v1.json",
  "title": "company-member.role_changed",
  "description": "Published when a member's role changes via PATCH /companies/:companyId/members/:memberId/role. Exchange: domain.events. Routing key: company-member.role_changed.",
  "type": "object",
  "required": ["companyId", "userId", "fromRole", "toRole"],
  "additionalProperties": false,
  "properties": {
    "companyId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "fromRole": { "type": "string", "enum": ["owner", "manager"] },
    "toRole": { "type": "string", "enum": ["owner", "manager"] }
  }
}
