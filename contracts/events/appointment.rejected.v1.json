{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crm-services/contracts/events/appointment.rejected.v1.json",
  "title": "appointment.rejected",
  "description": "Published when a company rejects an appointment request. Exchange: domain.events. Routing key: appointment.rejected.",
  "type": "object",
  "required": ["appointmentId", "companyId", "serviceId", "clientUserId", "companyName", "serviceName", "requestedStartAt"],
  "additionalProperties": false,
  "properties": {
    "appointmentId": { "type": "string", "format": "uuid" },
    "companyId": { "type": "string", "format": "uuid" },
    "serviceId": { "type": "string", "format": "uuid" },
    "clientUserId": { "type": "string", "format": "uuid" },
    "companyName": { "type": "string" },
    "serviceName": { "type": "string" },
    "requestedStartAt": { "type": "string", "format": "date-time" }
  }
}
