# Copy to docker/prod/.env.production and fill in real values. Never commit
# the real file. Used by the postgres/redis/rabbitmq/postgres-ai services
# defined directly in docker/prod/compose.yml - every app/worker service
# still reads its own .env.production from its own folder (see
# docker/prod/README.md).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

AI_POSTGRES_USER=ai
AI_POSTGRES_PASSWORD=change-me-too
AI_POSTGRES_DB=ai

RABBITMQ_DEFAULT_USER=crm
RABBITMQ_DEFAULT_PASS=change-me
